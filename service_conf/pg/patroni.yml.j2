scope: {{ patroni_scope }}
name: {{ patroni_name }}
namespace: {{ patroni_namespace }}

restapi:
  listen: {{ patroni_restapi_listen }}
  connect_address: {{ patroni_restapi_connect_address }}

etcd3:
  hosts: {{ patroni_etcd_hosts }}

bootstrap:
  method: initdb
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    master_start_timeout: 300
    synchronous_mode: on
    synchronous_mode_strict: on
    synchronous_node_count: 2
    postgresql:
      use_pg_rewind: true
      use_slots: true
      parameters:
        max_connections: 300
        shared_buffers: 4GB
        work_mem: 32MB
        maintenance_work_mem: 2GB
        effective_cache_size: 12GB
        checkpoint_timeout: 15min
        wal_compression: true
        min_wal_size: 2GB
        max_wal_size: 4GB
        wal_buffers: 32MB
        archive_mode: true
        archive_command: 'test ! -f /opt/backup/pgarchivewal/%f && cp %p /opt/backup/pgarchivewal/%f && chmod g+r /opt/backup/pgarchivewal/%f'
        wal_level: replica
        max_wal_senders: 10
        max_replication_slots: 10
        hot_standby: true
  initdb:
    - encoding: UTF8
    - locale: en_US.UTF-8
    - data-checksums
  pg_hba:
    - local all postgres peer
    - local all all peer
    - host all all 192.168.117.0/24 scram-sha-256
    - host replication replicator 192.168.117.123/32 scram-sha-256
    - host replication replicator 192.168.117.124/32 scram-sha-256
    - host replication replicator 192.168.117.125/32 scram-sha-256

postgresql:
  listen: {{ postgresql_listen }}
  connect_address: {{ postgresql_connect_address }}
  use_unix_socket: true
  data_dir: {{ postgresql_data_dir }}
  bin_dir: {{ postgresql_bin_dir }}
  config_dir: {{ postgresql_config_dir }}
  pgpass: {{ patroni_pgpass }}
  authentication:
    replication:
      username: replicator
      password: {{ replicatorpass }}
    superuser:
      username: postgres
      password: {{ postgrespass }}
  parameters:
    listen_addresses: "{{ postgresql_listen }}"
    port: {{ postgresql_port }}
    unix_socket_directories: /var/run/postgresql