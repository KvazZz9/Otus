network:
  version: 2
  renderer: networkd
  ethernets:
    ens192:
      mtu: 9000
      dhcp4: no
      dhcp6: no
      addresses:
        - {{ '192.168.117.131/24' if inventory_hostname == 'NFS01' else '192.168.117.132/24' }}
      routes:
        - to: default
          via: 192.168.117.1
      nameservers:
        addresses:
          - 192.168.3.4
          - 192.168.3.3